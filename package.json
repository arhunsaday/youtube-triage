{
  "name": "youtube-triage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clear your YouTube Watch Later by swiping: left to remove, right to keep, up to watch.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:firefox": "BROWSER=firefox vite build",
    "build:all": "pnpm build && pnpm build:firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests scripts vite.config.ts",
    "format:check": "prettier --check src tests scripts vite.config.ts",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "brand": "node scripts/brand.mjs",
    "ship": "node scripts/ship.mjs",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build:all"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.52.0",
    "motion": "^14.9.1",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.4",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "web-ext": "^10.7.0"
  }
}
